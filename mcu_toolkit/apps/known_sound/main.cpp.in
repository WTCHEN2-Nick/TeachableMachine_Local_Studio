/* Generated by scripts/vendor_known_sound.py from NuML App Builder v0.1.8 known_sound_runtime._MAIN_TEMPLATE; per-class thresholds added for Teachable Machine Local Studio. */
/**************************************************************************//**
 * @file     main.cpp
 * @brief    Live Known Sound runtime: DMIC -> YAMNet log-mel -> Ethos-U55.
 *
 * Generated by NuML Application Builder v0.1.8.  The frontend itself is not
 * generated: numl_yamnet_frontend.c beside this file is the same C the host
 * tests compile, so the tensor the board builds is the tensor TensorFlow was
 * compared against.
 ******************************************************************************/

/* TEACHABLE_MACHINE_LOCAL_STUDIO_KNOWN_SOUND_RUNTIME_V1 */
#include "BoardInit.hpp"
#include "BufAttributes.hpp"
#include "NNModel.hpp"
#include "pmu_counter.h"

#undef PI
#include "NuMicro.h"

#include "BoardConfig.h"
#include "numl_dmic.h"
#include "numl_known_sound.h"
#include "numl_yamnet_frontend.h"

#include <cmath>
#include <cstdint>
#include <cstdio>

#define LOG_LEVEL 2
#include "log_macros.h"

#undef ACTIVATION_BUF_SZ
#define ACTIVATION_BUF_SZ (@@ARENA@@)

#define KNOWN_SOUND_CLASSES      @@CLASS_COUNT@@
#define KNOWN_SOUND_PATCH_VALUES (NUML_YAMNET_PATCH_FRAMES * NUML_YAMNET_MEL_BANDS)

/* One second of audio, advanced half a second at a time. */
#define LIVE_WINDOW_SAMPLES      @@CLIP_SAMPLES@@
#define LIVE_HOP_SAMPLES         @@HOP_SAMPLES@@

/* Peak hold, not a rolling mean.  A door slam or a gunshot lasts 100-200 ms,
 * so averaging across hops suppresses exactly the events this model is for.
 * @@HOLD_HOPS@@ hops matches preview_peak_hold_seconds in the training project. */
#define LIVE_HOLD_HOPS           @@HOLD_HOPS@@


namespace arm {
namespace app {
static uint8_t tensorArena[ACTIVATION_BUF_SZ] ACTIVATION_BUF_ATTRIBUTE;
namespace nn {
extern const uint8_t *GetModelPointer();
extern size_t GetModelLen();
}
}
}

/* The scratch is far too large for DTCM, which has only tens of KiB left after
 * the stack.  .bss.sram.data is the scatter's SRAM01 region. */
#define SRAM_SCRATCH  __attribute__((section(".bss.sram.data")))

static int16_t s_ai16Window[LIVE_WINDOW_SAMPLES] SRAM_SCRATCH;
static float   s_afPcm[LIVE_WINDOW_SAMPLES]      SRAM_SCRATCH;
static float   s_afPatch[KNOWN_SOUND_PATCH_VALUES] SRAM_SCRATCH;

static float s_afHeld[KNOWN_SOUND_CLASSES];
static int   s_aiHold[KNOWN_SOUND_CLASSES];

static const char *const s_apszLabels[KNOWN_SOUND_CLASSES] =
{
@@LABELS@@
};

/* One independent sigmoid threshold per class (Studio class_thresholds). */
static const float s_afThreshold[KNOWN_SOUND_CLASSES] =
{
@@THRESHOLDS@@
};


static float RmsDbfs(const float *pfPcm, int iCount)
{
    float fSum = 0.0f;

    for (int i = 0; i < iCount; i++)
    {
        fSum += pfPcm[i] * pfPcm[i];
    }

    return 20.0f * log10f(sqrtf(fSum / (float)iCount) + 1e-12f);
}

int main()
{
    if (BoardInit() != 0)
    {
        printf_err("BoardInit failed\n");
        return 1;
    }

    /* Start the log transport before anything is printed and wait -- bounded --
     * for a host to open it.  On a board that prints over USB the first lines
     * are written while the host is still enumerating.  Both are nothing on a
     * board that prints over a UART. */
    BOARD_LOG_INIT();
    BOARD_LOG_WAIT();

    printf("\n==== Known Sound (live) ====\n");
    printf("INFO board %s, log via %s\n", BOARD_NAME, BOARD_LOG_TRANSPORT);

    arm::app::NNModel model;

    if (!model.Init(arm::app::tensorArena,
                    sizeof(arm::app::tensorArena),
                    arm::app::nn::GetModelPointer(),
                    arm::app::nn::GetModelLen()))
    {
        printf_err("Failed to initialise model\n");
        return 2;
    }

    /* The tensor arena must be Write-Through.
     *
     * ethosu_flush_dcache() in this BSP is an empty function, so nothing ever
     * cleans the D-cache before the NPU reads the input tensor.  Mapping the
     * arena WTRA sends CPU writes straight to memory instead.  Without it the
     * same input produces different outputs from one inference to the next. */
    static const ARM_MPU_Region_t asMpuConfig[] =
    {
        {
            ARM_MPU_RBAR(((unsigned int)arm::app::tensorArena), ARM_MPU_SH_NON, 0, 1, 1),
            ARM_MPU_RLAR((((unsigned int)arm::app::tensorArena) + ACTIVATION_BUF_SZ - 1U),
                         eMPU_ATTR_CACHEABLE_WTRA)
        }
    };
    InitPreDefMPURegion(&asMpuConfig[0], sizeof(asMpuConfig) / sizeof(asMpuConfig[0]));

    TfLiteTensor *psInput  = model.GetInputTensor(0);
    TfLiteTensor *psOutput = model.GetOutputTensor(0);

    if ((psInput == nullptr) || (psOutput == nullptr) ||
        (psInput->type != kTfLiteInt8) || (psOutput->type != kTfLiteInt8) ||
        (psInput->bytes != KNOWN_SOUND_PATCH_VALUES) ||
        (psOutput->bytes != KNOWN_SOUND_CLASSES) ||
        (psInput->data.int8 == nullptr) || (psOutput->data.int8 == nullptr))
    {
        printf_err("Known Sound model shape changed; expected %d-value int8 patch and %d classes\n",
                   (int)KNOWN_SOUND_PATCH_VALUES, (int)KNOWN_SOUND_CLASSES);
        return 3;
    }

    /* Never compiled in: a re-export changes them, and a stale constant would
     * quantise every patch slightly wrong with nothing to show for it. */
    const float fInScale = psInput->params.scale;
    const int   iInZero  = psInput->params.zero_point;

    if (!(fInScale > 0.0f) || !std::isfinite(fInScale))
    {
        printf_err("Known Sound input quantisation is not usable: scale=%.9g\n", (double)fInScale);
        return 3;
    }

    int aiThresholdCode[KNOWN_SOUND_CLASSES];

    for (int i = 0; i < KNOWN_SOUND_CLASSES; i++)
    {
        aiThresholdCode[i] = NuML_KnownSound_ThresholdCode(
            s_afThreshold[i], psOutput->params.scale, psOutput->params.zero_point);
    }

    printf("INFO model %u bytes, arena %u bytes\n",
           (unsigned)arm::app::nn::GetModelLen(),
           (unsigned)sizeof(arm::app::tensorArena));
    printf("INFO input scale %.9g zero %d, output scale %.9g zero %d\n",
           (double)fInScale, iInZero,
           (double)psOutput->params.scale, (int)psOutput->params.zero_point);
    for (int i = 0; i < KNOWN_SOUND_CLASSES; i++)
    {
        printf("INFO threshold[%s] %.2f -> output code >= %d\n",
               s_apszLabels[i], (double)s_afThreshold[i], aiThresholdCode[i]);
    }

    const int32_t i32Rate = NuML_Dmic_Init(NUML_YAMNET_SAMPLE_RATE);

    if (i32Rate <= 0)
    {
        printf_err("DMIC init failed\n");
        return 4;
    }

    if (NuML_Dmic_Start() != 0)
    {
        printf_err("DMIC start failed\n");
        return 4;
    }

    for (int i = 0; i < KNOWN_SOUND_CLASSES; i++)
    {
        s_afHeld[i] = 0.0f;
        s_aiHold[i] = 0;
    }

    /* The frontend is tuned for exactly 16 kHz; a divider that lands slightly
     * off shifts every mel band, so report what the hardware achieved rather
     * than what was asked for. */
    printf("---- live: %s, DMIC channel %d ----\n", BOARD_NAME, (int)BOARD_DMIC_CHANNEL);
    printf("INFO sample rate requested %d Hz, achieved %d Hz, mono%s\n",
           (int)NUML_YAMNET_SAMPLE_RATE, (int)i32Rate,
           (i32Rate == (int32_t)NUML_YAMNET_SAMPLE_RATE) ? "" : "  <-- MISMATCH");
    printf("INFO window %d samples, hop %d samples, peak hold %d hops\n",
           (int)LIVE_WINDOW_SAMPLES, (int)LIVE_HOP_SAMPLES, (int)LIVE_HOLD_HOPS);

    const uint32_t u32Hz = SystemCoreClock;

    while (true)
    {
        /* Peek a whole second, then consume only the hop: the next pass sees
         * the same audio shifted by half a second. */
        while (NuML_Dmic_Available() < LIVE_WINDOW_SAMPLES)
        {
            /* Half a second of otherwise idle waiting per hop: the natural
             * place to drain the log ring into the USB endpoint. */
            BOARD_LOG_PUMP();
            __NOP();
        }

        NuML_Dmic_Peek(s_ai16Window, LIVE_WINDOW_SAMPLES);
        NuML_Dmic_Consume(LIVE_HOP_SAMPLES);

        for (int i = 0; i < LIVE_WINDOW_SAMPLES; i++)
        {
            s_afPcm[i] = (float)s_ai16Window[i] / 32768.0f;
        }

        const uint64_t u64T0 = pmu_get_systick_Count();
        NuML_Yamnet_Patch(s_afPcm, s_afPatch);

        for (int i = 0; i < KNOWN_SOUND_PATCH_VALUES; i++)
        {
            int iCode = (int)lrintf(s_afPatch[i] / fInScale) + iInZero;

            if (iCode < -128) iCode = -128;

            if (iCode > 127) iCode = 127;

            psInput->data.int8[i] = (int8_t)iCode;
        }

        const uint64_t u64T1 = pmu_get_systick_Count();

        if (!model.RunInference())
        {
            printf_err("Inference failed\n");
            return 5;
        }

        const uint64_t u64T2 = pmu_get_systick_Count();

        float afScores[KNOWN_SOUND_CLASSES];
        NuML_KnownSound_Scores(psOutput->data.int8, KNOWN_SOUND_CLASSES,
                               psOutput->params.scale,
                               psOutput->params.zero_point, afScores);

        printf("live rms %6.1f dBFS | front %4u ms | npu %4u ms | ovr %u | drop %u |",
               (double)RmsDbfs(s_afPcm, LIVE_WINDOW_SAMPLES),
               (unsigned)((u64T1 - u64T0) * 1000U / u32Hz),
               (unsigned)((u64T2 - u64T1) * 1000U / u32Hz),
               (unsigned)NuML_Dmic_Overruns(),
               (unsigned)BOARD_LOG_DROPPED());

        for (int i = 0; i < KNOWN_SOUND_CLASSES; i++)
        {
            if (afScores[i] >= s_afHeld[i])
            {
                s_afHeld[i] = afScores[i];
                s_aiHold[i] = LIVE_HOLD_HOPS;
            }
            else if (s_aiHold[i] > 0)
            {
                s_aiHold[i]--;
            }
            else
            {
                s_afHeld[i] = afScores[i];
            }

            /* Every class is judged on its own: these are independent sigmoid
             * scores, not a probability distribution.  No argmax, no softmax,
             * and they are not normalised to sum to one. */
            printf(" %s=%.3f%s",
                   s_apszLabels[i],
                   (double)s_afHeld[i],
                   (psOutput->data.int8[i] >= aiThresholdCode[i]) ? "*" : " ");
        }

        printf("\n");
    }
}
