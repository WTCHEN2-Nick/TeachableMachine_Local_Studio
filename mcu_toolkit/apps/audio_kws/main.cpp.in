/**************************************************************************//**
 * @file     main.cpp
 * @brief    Live NuML M55M1 Audio KWS runtime generated from model_contract.json
 ******************************************************************************/

/* TEACHABLE_MACHINE_LOCAL_STUDIO_AUDIO_KWS_RUNTIME_V1: generated by scripts/vendor_kws_template.py from NuML App Builder v0.1.8 audio_kws_runtime._render_main; tables come from tm_local.audio_frontend. */
#include "BoardInit.hpp"
#include "BufAttributes.hpp"
#include "NNModel.hpp"
#include "Profiler.hpp"
#include "pmu_counter.h"

#undef PI
#include "NuMicro.h"
#include "arm_math.h"

#include <algorithm>
#include <cfloat>
#include <cmath>
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <cstring>

#define LOG_LEVEL 2
#include "log_macros.h"

#if defined(NUML_USE_USB_CDC)
#include "numl_cdc.h"
#include "numl_usbd.h"
#define BOARD_LOG_INIT()    NuML_USBD_Init()
#define BOARD_LOG_PUMP()    NuML_CDC_Pump()
#define BOARD_LOG_PENDING() NuML_CDC_Pending()
#define BOARD_LOG_DROPPED() NuML_CDC_DroppedBytes()

/* Bounded wait for a terminal to open the virtual COM port, mirroring known_sound's
 * BoardConfig.h. The banner and the model-contract self-test print exactly once, and a host
 * needs a second or two to enumerate the port; without this the student's first lines are
 * already gone by the time PuTTY connects. It gives up after NUML_BOARD_LOG_WAIT_MS rather
 * than refusing to boot with no terminal attached.
 *
 * 10 ms per step on purpose: CLK_SysTickDelay counts a 24-bit SysTick, which at 220 MHz tops
 * out around 76 ms, so a single long delay would silently wrap. */
#ifndef NUML_BOARD_LOG_WAIT_MS
#define NUML_BOARD_LOG_WAIT_MS 10000
#endif
static inline void NuML_BoardLogWait(void)
{
    for (int step = 0; step < (NUML_BOARD_LOG_WAIT_MS / 10); step++)
    {
        if (NuML_CDC_IsOpen()) { return; }

        CLK_SysTickDelay(10000);
    }
}
#define BOARD_LOG_WAIT()   NuML_BoardLogWait()
#else
#define BOARD_LOG_INIT()    ((void)0)
#define BOARD_LOG_PUMP()    ((void)0)
#define BOARD_LOG_PENDING() (0)
#define BOARD_LOG_DROPPED() (0u)
#define BOARD_LOG_WAIT()    ((void)0)
#endif

/* One hop's KWS + timing text is a few hundred bytes, but NuML_CDC_Pump() moves at most
 * one bulk packet per call and does nothing at all while the previous packet is still
 * waiting for the host to collect it (see numl_cdc.c). A single pump call before sleeping
 * left most of a hop's line queued, and the next hop's text queued on top of that,
 * silently overflowing the ring and corrupting both lines -- this is why a live capture
 * shows dropped and duplicated characters instead of a clean log.
 *
 * Drain everything that can be drained right now instead of guessing how many pumps one
 * hop needs. NUML_LOG_DRAIN_MAX_PUMPS bounds the loop so a terminal that has gone away
 * (whose bulk-IN packet is never collected, leaving BOARD_LOG_PENDING() permanently true)
 * cannot spin here forever: it falls back to the pre-existing drop-and-continue behaviour,
 * now visible via BOARD_LOG_DROPPED() in the hop line itself. The bound is not a timing
 * budget -- a packet that is not yet collected on this call is retried on every later wake
 * of this same idle loop, roughly every 10 ms (one DMA block) for the remainder of the
 * hop's ~hundreds-of-ms wait -- it only needs to be large enough to cover one hop's several
 * packets' worth of output when the host *is* draining normally. */
#define NUML_LOG_DRAIN_MAX_PUMPS 64U
static inline void NuML_DrainLogRing(void)
{
    for (uint32_t attempt = 0U; (attempt < NUML_LOG_DRAIN_MAX_PUMPS) && BOARD_LOG_PENDING(); ++attempt)
    {
        BOARD_LOG_PUMP();
    }
}

#undef ACTIVATION_BUF_SZ
#define ACTIVATION_BUF_SZ (@@ARENA@@)

#define NUML_SAMPLE_RATE       (@@SAMPLE_RATE@@U)
#define NUML_CLIP_SAMPLES      (@@CLIP_SAMPLES@@U)
#define NUML_INFERENCE_HOP     (@@INFERENCE_HOP@@U)
#define NUML_FRAME_LENGTH      (@@FRAME_LENGTH@@U)
#define NUML_FRAME_STEP        (@@FRAME_STEP@@U)
#define NUML_FRAME_COUNT       (@@FRAME_COUNT@@U)
#define NUML_FFT_LENGTH        (@@FFT_LENGTH@@U)
#define NUML_SPECTRUM_BINS     (NUML_FFT_LENGTH / 2U + 1U)
#define NUML_MEL_BINS          (@@MEL_BINS@@U)
#define NUML_MEL_NNZ           (@@MEL_NNZ@@U)
#define NUML_FEATURE_VALUES    (NUML_FRAME_COUNT * NUML_MEL_BINS)
#define NUML_DMA_BLOCK_SAMPLES (160U)
#define NUML_DMA_CHANNEL       (2U)
#define NUML_LABEL_COUNT       (@@LABEL_COUNT@@U)
#define NUML_BACKGROUND_INDEX  (@@BACKGROUND_INDEX@@U)
/* 1 when one of this project's classes really is a background/silence class; 0 when
 * none is, and then NUML_BACKGROUND_INDEX is a meaningless fallback that must not be
 * read -- see the #if NUML_HAS_BACKGROUND block in NuML_ProcessKwsScores(). */
#define NUML_HAS_BACKGROUND    (@@HAS_BACKGROUND@@)
#define NUML_SMOOTH_WINDOWS    (@@SMOOTH_WINDOWS@@U)
#define NUML_REQUIRED_HITS     (@@REQUIRED_HITS@@U)
#define NUML_COOLDOWN_HOPS     (@@COOLDOWN_HOPS@@U)
#define NUML_TRIGGER_THRESHOLD (@@TRIGGER_THRESHOLD@@)
#define NUML_TRIGGER_MARGIN    (@@TRIGGER_MARGIN@@)
#define NUML_REARM_SCORE       (@@REARM_SCORE@@)
#define NUML_RMS_GATE_DBFS     (@@RMS_GATE_DBFS@@)
#define NUML_DB_FLOOR          (@@DB_FLOOR@@)
#define NUML_LOG_EPSILON       (@@LOG_EPSILON@@)
#define NUML_INPUT_SCALE       (@@INPUT_SCALE@@)
#define NUML_INPUT_ZERO_POINT  (@@INPUT_ZERO_POINT@@)
#define NUML_OUTPUT_SCALE      (@@OUTPUT_SCALE@@)
#define NUML_OUTPUT_ZERO_POINT (@@OUTPUT_ZERO_POINT@@)

#define NUML_AUDIO_BUFFER_ATTRIBUTE \
    __attribute__((aligned(32), section(".bss.NoInit.activation_buf_sram")))

namespace arm {
namespace app {
static uint8_t tensorArena[ACTIVATION_BUF_SZ] ACTIVATION_BUF_ATTRIBUTE;
namespace nn {
extern const uint8_t *GetModelPointer();
extern size_t GetModelLen();
}
}
}

static const char *const s_labels[NUML_LABEL_COUNT] = {
@@LABELS@@
};

/* Sparse mel filterbank exported from tm_local.audio_frontend.mel_filterbank(): row-normalised
 * triangular filters as (start bin, count, offset into s_melWeights). */
static const uint16_t s_melStart[NUML_MEL_BINS] = {
@@MEL_START@@
};
static const uint16_t s_melCount[NUML_MEL_BINS] = {
@@MEL_COUNT@@
};
static const uint16_t s_melOffset[NUML_MEL_BINS] = {
@@MEL_OFFSET@@
};
static const float s_melWeights[NUML_MEL_NNZ] = {
@@MEL_WEIGHTS@@
};
/* Symmetric Hann (np.hanning) exported from the training frontend. */
static const float s_hannTable[NUML_FRAME_LENGTH] = {
@@HANN@@
};

NVT_DTCM __ALIGNED(32) static LPDSCT_T s_dmaDescriptors[2];
NVT_NONCACHEABLE __ALIGNED(32) static int16_t s_dmaSamples[2][NUML_DMA_BLOCK_SAMPLES];

static int16_t s_audioRing[NUML_CLIP_SAMPLES] NUML_AUDIO_BUFFER_ATTRIBUTE;
static int16_t s_audioClip[NUML_CLIP_SAMPLES] NUML_AUDIO_BUFFER_ATTRIBUTE;
static float s_featureDb[NUML_FEATURE_VALUES] NUML_AUDIO_BUFFER_ATTRIBUTE;
static float s_fftInput[NUML_FFT_LENGTH] NUML_AUDIO_BUFFER_ATTRIBUTE;
static float s_fftOutput[NUML_FFT_LENGTH] NUML_AUDIO_BUFFER_ATTRIBUTE;
static float s_power[NUML_SPECTRUM_BINS] NUML_AUDIO_BUFFER_ATTRIBUTE;

static volatile uint32_t s_ringWriteIndex = 0U;
static volatile uint32_t s_totalCaptured = 0U;
static volatile uint32_t s_dmaCompletedIndex = 0U;
static volatile uint32_t s_dmaErrorCount = 0U;
static arm_rfft_fast_instance_f32 s_rfft;

static float s_scoreHistory[NUML_SMOOTH_WINDOWS][NUML_LABEL_COUNT];
static uint32_t s_scoreHistoryCount = 0U;
static uint32_t s_scoreHistoryWrite = 0U;
/* Any valid label index: s_candidateHits starts at 0, so the initial value is inert.
 * It deliberately does NOT use NUML_BACKGROUND_INDEX, which is meaningless when the
 * project has no background class. */
static uint32_t s_candidateIndex = 0U;
static uint32_t s_candidateHits = 0U;
static uint32_t s_backgroundHits = 0U;
static uint32_t s_lastTriggerHop = 0U;
static bool s_haveTrigger = false;
static bool s_triggerArmed = true;

static void NuML_PushAudioBlock(const int16_t *samples, uint32_t count)
{
    uint32_t write = s_ringWriteIndex;
    for (uint32_t index = 0U; index < count; ++index)
    {
        s_audioRing[write] = samples[index];
        write = (write + 1U == NUML_CLIP_SAMPLES) ? 0U : write + 1U;
    }
    s_ringWriteIndex = write;
    s_totalCaptured += count;
}

extern "C" NVT_ITCM void LPPDMA_IRQHandler(void)
{
    const uint32_t transferStatus = LPPDMA_GET_TD_STS(LPPDMA);
    if ((transferStatus & (1UL << NUML_DMA_CHANNEL)) != 0U)
    {
        LPPDMA_CLR_TD_FLAG(LPPDMA, (1UL << NUML_DMA_CHANNEL));
        const uint32_t completed = s_dmaCompletedIndex;
        NuML_PushAudioBlock(s_dmaSamples[completed], NUML_DMA_BLOCK_SAMPLES);
        s_dmaCompletedIndex = completed ^ 1U;
    }

    const uint32_t abortStatus = LPPDMA_GET_ABORT_STS(LPPDMA);
    if ((abortStatus & (1UL << NUML_DMA_CHANNEL)) != 0U)
    {
        LPPDMA_CLR_ABORT_FLAG(LPPDMA, (1UL << NUML_DMA_CHANNEL));
        ++s_dmaErrorCount;
    }
    __DSB();
    __ISB();
}

static bool NuML_StartDmic(void)
{
    SYS_UnlockReg();
    const uint32_t apll = CLK_EnableAPLL(
        CLK_APLLCTL_APLLSRC_HIRC,
        DMIC_APLL1_FREQ_196608KHZ,
        CLK_APLL1_SELECT);
    CLK_SetModuleClock(DMIC0_MODULE, CLK_DMICSEL_DMIC0SEL_APLL1_DIV2, MODULE_NoMsk);
    CLK_EnableModuleClock(DMIC0_MODULE);
    SYS_ResetModule(SYS_DMIC0RST);
    CLK_EnableModuleClock(LPPDMA0_MODULE);
    CLK_EnableModuleClock(LPSRAM0_MODULE);
    SYS_ResetModule(SYS_LPPDMA0RST);
    @@DMIC_CLK_MACRO@@();
    @@DMIC_DAT_MACRO@@();
    SYS_LockReg();

    info("Audio KWS APLL1: %lu Hz\n", (unsigned long)apll);
    DMIC_Open(DMIC0);
    DMIC_SET_DOWNSAMPLE(DMIC0, DMIC_DOWNSAMPLE_256);
    const uint32_t actualRate = DMIC_SetSampleRate(DMIC0, NUML_SAMPLE_RATE);
    DMIC_SetFIFOWidth(DMIC0, DMIC_FIFOWIDTH_16);
    DMIC_ClearFIFO(DMIC0);
    while (!DMIC_IS_FIFOEMPTY(DMIC0)) {}
    DMIC_ResetDSP(DMIC0);
    DMIC_SetDSPGainVolume(DMIC0, @@DMIC_CHANNEL_MASK@@, 36);

    s_dmaDescriptors[0].CTL =
        ((NUML_DMA_BLOCK_SAMPLES - 1U) << PDMA_DSCT_CTL_TXCNT_Pos) |
        PDMA_WIDTH_16 | PDMA_SAR_FIX | PDMA_DAR_INC |
        PDMA_REQ_SINGLE | PDMA_OP_SCATTER;
    s_dmaDescriptors[0].SA = (uint32_t)&DMIC0->FIFO;
    s_dmaDescriptors[0].DA = (uint32_t)&s_dmaSamples[0][0];
    s_dmaDescriptors[0].NEXT = (uint32_t)&s_dmaDescriptors[1];
    s_dmaDescriptors[1].CTL = s_dmaDescriptors[0].CTL;
    s_dmaDescriptors[1].SA = (uint32_t)&DMIC0->FIFO;
    s_dmaDescriptors[1].DA = (uint32_t)&s_dmaSamples[1][0];
    s_dmaDescriptors[1].NEXT = (uint32_t)&s_dmaDescriptors[0];

    LPPDMA_Open(LPPDMA, (1UL << NUML_DMA_CHANNEL));
    LPPDMA_SetTransferMode(
        LPPDMA,
        NUML_DMA_CHANNEL,
        LPPDMA_DMIC0_RX,
        TRUE,
        (uint32_t)&s_dmaDescriptors[0]);
    LPPDMA_EnableInt(LPPDMA, NUML_DMA_CHANNEL, LPPDMA_INT_TRANS_DONE);
    NVIC_SetPriority(LPPDMA_IRQn, 1U);
    NVIC_EnableIRQ(LPPDMA_IRQn);

    s_ringWriteIndex = 0U;
    s_totalCaptured = 0U;
    s_dmaCompletedIndex = 0U;
    s_dmaErrorCount = 0U;

    DMIC_EnableChMsk(DMIC0, @@DMIC_CHANNEL_MASK@@);
    CLK_SysTickDelay(10000U);
    DMIC_ClearFIFO(DMIC0);
    while (!DMIC_IS_FIFOEMPTY(DMIC0)) {}
    DMIC_ENABLE_LPPDMA(DMIC0);

    info("Audio KWS DMIC sample rate: %lu Hz\n", (unsigned long)actualRate);
    if (actualRate != NUML_SAMPLE_RATE)
    {
        printf_err("DMIC sample rate mismatch: expected %lu, got %lu\n",
                   (unsigned long)NUML_SAMPLE_RATE, (unsigned long)actualRate);
        return false;
    }
    return true;
}

static bool NuML_SnapshotLatestClip(uint32_t previousSample, uint32_t *snapshotSample)
{
    const uint32_t primask = __get_PRIMASK();
    __disable_irq();
    const uint32_t total = s_totalCaptured;
    if ((total < NUML_CLIP_SAMPLES) ||
        ((previousSample != 0U) && ((uint32_t)(total - previousSample) < NUML_INFERENCE_HOP)))
    {
        if (primask == 0U) { __enable_irq(); }
        return false;
    }

    const uint32_t start = s_ringWriteIndex;
    const uint32_t firstCount = NUML_CLIP_SAMPLES - start;
    memcpy(s_audioClip, &s_audioRing[start], firstCount * sizeof(int16_t));
    if (start != 0U)
    {
        memcpy(&s_audioClip[firstCount], s_audioRing, start * sizeof(int16_t));
    }
    *snapshotSample = total;
    if (primask == 0U) { __enable_irq(); }
    return true;
}

static bool NuML_InitFrontend(void)
{
    if (arm_rfft_fast_init_f32(&s_rfft, NUML_FFT_LENGTH) != ARM_MATH_SUCCESS)
    {
        return false;
    }
    return true;
}

static float NuML_ClipRmsDbfs(void)
{
    double sum = 0.0;
    for (uint32_t index = 0U; index < NUML_CLIP_SAMPLES; ++index)
    {
        const double value = (double)s_audioClip[index] / 32768.0;
        sum += value * value;
    }
    const float rms = sqrtf((float)(sum / (double)NUML_CLIP_SAMPLES));
    return 20.0f * log10f(std::max(rms, 1.0e-12f));
}

static float NuML_MelPower(uint32_t melIndex)
{
    const uint32_t start = s_melStart[melIndex];
    const uint32_t count = s_melCount[melIndex];
    const float *weights = &s_melWeights[s_melOffset[melIndex]];
    float sum = 0.0f;
    for (uint32_t index = 0U; index < count; ++index)
    {
        sum += s_power[start + index] * weights[index];
    }
    return sum;
}

static bool NuML_ExtractLogMel(TfLiteTensor *inputTensor, float *rmsDbfs)
{
    if ((inputTensor == nullptr) || (inputTensor->type != kTfLiteInt8) ||
        (inputTensor->dims == nullptr) || (inputTensor->dims->size != 4) ||
        (inputTensor->dims->data[0] != 1) ||
        (inputTensor->dims->data[1] != (int)NUML_FRAME_COUNT) ||
        (inputTensor->dims->data[2] != (int)NUML_MEL_BINS) ||
        (inputTensor->dims->data[3] != 1) ||
        (inputTensor->bytes != NUML_FEATURE_VALUES) ||
        (inputTensor->data.int8 == nullptr) ||
        !std::isfinite(inputTensor->params.scale) ||
        !(inputTensor->params.scale > 0.0f))
    {
        printf_err("Audio model input contract mismatch\n");
        return false;
    }

    *rmsDbfs = NuML_ClipRmsDbfs();
    float globalMaximum = -FLT_MAX;
    for (uint32_t frame = 0U; frame < NUML_FRAME_COUNT; ++frame)
    {
        memset(s_fftInput, 0, sizeof(s_fftInput));
        const uint32_t sourceOffset = frame * NUML_FRAME_STEP;
        for (uint32_t index = 0U; index < NUML_FRAME_LENGTH; ++index)
        {
            const float pcm = (float)s_audioClip[sourceOffset + index] / 32768.0f;
            s_fftInput[index] = pcm * s_hannTable[index];
        }
        arm_rfft_fast_f32(&s_rfft, s_fftInput, s_fftOutput, 0U);

        s_power[0] = s_fftOutput[0] * s_fftOutput[0];
        s_power[NUML_FFT_LENGTH / 2U] = s_fftOutput[1] * s_fftOutput[1];
        for (uint32_t bin = 1U; bin < NUML_FFT_LENGTH / 2U; ++bin)
        {
            const float real = s_fftOutput[2U * bin];
            const float imaginary = s_fftOutput[2U * bin + 1U];
            s_power[bin] = real * real + imaginary * imaginary;
        }

        for (uint32_t mel = 0U; mel < NUML_MEL_BINS; ++mel)
        {
            const float melPower = std::max(NuML_MelPower(mel), NUML_LOG_EPSILON);
            const float db = 10.0f * log10f(melPower);
            s_featureDb[frame * NUML_MEL_BINS + mel] = db;
            globalMaximum = std::max(globalMaximum, db);
        }
    }

    int8_t *destination = inputTensor->data.int8;
    const float scale = inputTensor->params.scale;
    const int32_t zeroPoint = inputTensor->params.zero_point;
    for (uint32_t index = 0U; index < NUML_FEATURE_VALUES; ++index)
    {
        float relative = s_featureDb[index] - globalMaximum;
        relative = std::min(0.0f, std::max(NUML_DB_FLOOR, relative));
        const float normalized = (relative - NUML_DB_FLOOR) / -NUML_DB_FLOOR;
        int32_t quantized = (int32_t)lrintf(normalized / scale) + zeroPoint;
        quantized = std::min((int32_t)127, std::max((int32_t)-128, quantized));
        destination[index] = (int8_t)quantized;
    }
    return true;
}

static bool NuML_ReadScores(const TfLiteTensor *outputTensor, float *scores)
{
    if ((outputTensor == nullptr) || (outputTensor->type != kTfLiteInt8) ||
        (outputTensor->dims == nullptr) || (outputTensor->dims->size != 2) ||
        (outputTensor->dims->data[0] != 1) ||
        (outputTensor->dims->data[1] != (int)NUML_LABEL_COUNT) ||
        (outputTensor->bytes != NUML_LABEL_COUNT) ||
        (outputTensor->data.int8 == nullptr) ||
        !std::isfinite(outputTensor->params.scale) ||
        !(outputTensor->params.scale > 0.0f))
    {
        return false;
    }
    for (uint32_t index = 0U; index < NUML_LABEL_COUNT; ++index)
    {
        scores[index] = outputTensor->params.scale *
            ((float)outputTensor->data.int8[index] - (float)outputTensor->params.zero_point);
    }
    return true;
}

static void NuML_ProcessKwsScores(const float *scores, uint32_t inferenceHop, float rmsDbfs,
                                   uint32_t frontendUs, uint32_t inferenceUs, uint32_t dmaErrors)
{
    memcpy(s_scoreHistory[s_scoreHistoryWrite], scores, sizeof(float) * NUML_LABEL_COUNT);
    s_scoreHistoryWrite = (s_scoreHistoryWrite + 1U) % NUML_SMOOTH_WINDOWS;
    if (s_scoreHistoryCount < NUML_SMOOTH_WINDOWS) { ++s_scoreHistoryCount; }

    float average[NUML_LABEL_COUNT] = {0.0f};
    for (uint32_t window = 0U; window < s_scoreHistoryCount; ++window)
    {
        for (uint32_t label = 0U; label < NUML_LABEL_COUNT; ++label)
        {
            average[label] += s_scoreHistory[window][label];
        }
    }
    for (uint32_t label = 0U; label < NUML_LABEL_COUNT; ++label)
    {
        average[label] /= (float)s_scoreHistoryCount;
    }

    uint32_t best = 0U;
    for (uint32_t label = 1U; label < NUML_LABEL_COUNT; ++label)
    {
        if (average[label] > average[best]) { best = label; }
    }

    /* One line per hop, not two: the separate "KWS timing" line used to be printed with
     * no drain behind it at all (see NuML_DrainLogRing()), and every extra info()/printf()
     * call is another "INFO - " prefix plus newline for the ring to carry. drop= surfaces
     * NuML_CDC_DroppedBytes() so any future overflow is a number in the log instead of a
     * silent mystery. best is starred in the per-class list below: KWS is a single-winner
     * (argmax) classifier, unlike Known Sound's independent per-class thresholds, so there
     * is exactly one marker to place, on the class this hop actually picked. */
    info("KWS hop=%lu rms=%.1f dBFS top=%s %.3f frontend=%lu us inference=%lu us "
         "dma_errors=%lu drop=%lu |",
         (unsigned long)inferenceHop, (double)rmsDbfs, s_labels[best], (double)average[best],
         (unsigned long)frontendUs, (unsigned long)inferenceUs, (unsigned long)dmaErrors,
         (unsigned long)BOARD_LOG_DROPPED());
    for (uint32_t label = 0U; label < NUML_LABEL_COUNT; ++label)
    {
        printf(" %s=%.3f%s", s_labels[label], (double)average[label], (label == best) ? "*" : " ");
    }
    printf("\n");
    NuML_DrainLogRing();

    const bool quiet = rmsDbfs < NUML_RMS_GATE_DBFS;
    const bool scorePass = average[best] >= NUML_TRIGGER_THRESHOLD;
#if NUML_HAS_BACKGROUND
    /* The background class means "nothing was said": it must never fire an action, and it is
     * the baseline the winner has to beat by NUML_TRIGGER_MARGIN. */
    const bool background = best == NUML_BACKGROUND_INDEX;
    const bool marginPass = average[best] >= average[NUML_BACKGROUND_INDEX] + NUML_TRIGGER_MARGIN;
    /* Upstream's re-arm rule, unchanged: the keyword has faded when its smoothed score drops
     * back below NUML_REARM_SCORE. */
    const bool released = average[best] < NUML_REARM_SCORE;
#else
    /* This project has no background/silence class (labels like ["yes", "no"]), so every label
     * may trigger and NUML_BACKGROUND_INDEX is a meaningless 0 fallback that must not be read.
     * The margin baseline becomes the runner-up score: with a baseline of 0 the margin test
     * would reduce to "average[best] >= NUML_TRIGGER_MARGIN", which NUML_TRIGGER_THRESHOLD
     * already subsumes, and the tunable would silently do nothing. */
    const bool background = false;
    float runnerUp = 0.0f;
    for (uint32_t label = 0U; label < NUML_LABEL_COUNT; ++label)
    {
        if ((label != best) && (average[label] > runnerUp)) { runnerUp = average[label]; }
    }
    const bool marginPass = average[best] >= runnerUp + NUML_TRIGGER_MARGIN;
    /* ...and the re-arm rule cannot be NUML_REARM_SCORE either. The scores are one softmax, so
     * with two labels the winner is ALWAYS >= 0.5, i.e. always above any sensible re-arm score:
     * the only thing that could ever re-arm the trigger would be the RMS gate, so the app would
     * fire once per silence rather than once per spoken word. Release the trigger as soon as
     * the conditions that fired it stop holding -- the keyword is no longer being said. */
    const bool released = !scorePass || !marginPass;
#endif

    if (quiet || background || !scorePass || !marginPass)
    {
        s_candidateHits = 0U;
        if (quiet || background || released)
        {
            if (++s_backgroundHits >= NUML_REQUIRED_HITS) { s_triggerArmed = true; }
        }
        else
        {
            s_backgroundHits = 0U;
        }
        return;
    }

    s_backgroundHits = 0U;
    if (s_candidateIndex == best)
    {
        ++s_candidateHits;
    }
    else
    {
        s_candidateIndex = best;
        s_candidateHits = 1U;
    }

    const bool cooldownDone = !s_haveTrigger ||
        ((uint32_t)(inferenceHop - s_lastTriggerHop) >= NUML_COOLDOWN_HOPS);
    if (s_triggerArmed && cooldownDone && s_candidateHits >= NUML_REQUIRED_HITS)
    {
        info("KWS DETECTED: label=%s score=%.3f hop=%lu\n",
             s_labels[best], (double)average[best], (unsigned long)inferenceHop);
        s_lastTriggerHop = inferenceHop;
        s_haveTrigger = true;
        s_triggerArmed = false;
        s_candidateHits = 0U;
    }
}

int main()
{
    if (BoardInit() != 0)
    {
        printf_err("BoardInit failed\n");
        return 1;
    }

    BOARD_LOG_INIT();
    BOARD_LOG_WAIT();

    arm::app::NNModel model;
    if (!model.Init(arm::app::tensorArena,
                    sizeof(arm::app::tensorArena),
                    arm::app::nn::GetModelPointer(),
                    arm::app::nn::GetModelLen()))
    {
        printf_err("Failed to initialise model\n");
        return 2;
    }

    static const ARM_MPU_Region_t mpuConfig[] =
    {
        {
            ARM_MPU_RBAR(((unsigned int)arm::app::tensorArena), ARM_MPU_SH_NON, 0, 1, 1),
            ARM_MPU_RLAR((((unsigned int)arm::app::tensorArena) + ACTIVATION_BUF_SZ - 1U),
                         eMPU_ATTR_CACHEABLE_WTRA)
        }
    };
    InitPreDefMPURegion(&mpuConfig[0], sizeof(mpuConfig) / sizeof(mpuConfig[0]));

    if ((model.GetNumInputs() != 1U) || (model.GetNumOutputs() != 1U))
    {
        printf_err("KWS model tensor count changed; expected 1 input / 1 output, got %lu / %lu\n",
                   (unsigned long)model.GetNumInputs(), (unsigned long)model.GetNumOutputs());
        return 3;
    }

    TfLiteTensor *inputTensor = model.GetInputTensor(0);
    TfLiteTensor *outputTensor = model.GetOutputTensor(0);
    if ((inputTensor == nullptr) || (inputTensor->dims == nullptr) ||
        (inputTensor->dims->size != 4) ||
        (inputTensor->dims->data[0] != 1) ||
        (inputTensor->dims->data[1] != (int)NUML_FRAME_COUNT) ||
        (inputTensor->dims->data[2] != (int)NUML_MEL_BINS) ||
        (inputTensor->dims->data[3] != 1) ||
        (inputTensor->type != kTfLiteInt8) ||
        (inputTensor->bytes != NUML_FEATURE_VALUES) ||
        (inputTensor->data.int8 == nullptr) ||
        !std::isfinite(inputTensor->params.scale) ||
        !(inputTensor->params.scale > 0.0f) ||
        (inputTensor->params.zero_point < -128) ||
        (inputTensor->params.zero_point > 127) ||
        (fabsf(inputTensor->params.scale - NUML_INPUT_SCALE) >
         std::max(1.0e-9f, fabsf(NUML_INPUT_SCALE) * 1.0e-6f)) ||
        (inputTensor->params.zero_point != NUML_INPUT_ZERO_POINT))
    {
        printf_err("KWS input layer changed; expected [1,%lu,%lu,1] INT8 bytes=%lu scale=%.9g zero=%ld\n",
                   (unsigned long)NUML_FRAME_COUNT, (unsigned long)NUML_MEL_BINS,
                   (unsigned long)NUML_FEATURE_VALUES, (double)NUML_INPUT_SCALE,
                   (long)NUML_INPUT_ZERO_POINT);
        return 3;
    }
    if ((outputTensor == nullptr) || (outputTensor->dims == nullptr) ||
        (outputTensor->dims->size != 2) ||
        (outputTensor->dims->data[0] != 1) ||
        (outputTensor->dims->data[1] != (int)NUML_LABEL_COUNT) ||
        (outputTensor->type != kTfLiteInt8) ||
        (outputTensor->bytes != NUML_LABEL_COUNT) ||
        (outputTensor->data.int8 == nullptr) ||
        !std::isfinite(outputTensor->params.scale) ||
        !(outputTensor->params.scale > 0.0f) ||
        (outputTensor->params.zero_point < -128) ||
        (outputTensor->params.zero_point > 127) ||
        (fabsf(outputTensor->params.scale - NUML_OUTPUT_SCALE) >
         std::max(1.0e-9f, fabsf(NUML_OUTPUT_SCALE) * 1.0e-6f)) ||
        (outputTensor->params.zero_point != NUML_OUTPUT_ZERO_POINT))
    {
        printf_err("KWS output layer changed; expected [1,%lu] INT8 bytes=%lu scale=%.9g zero=%ld\n",
                   (unsigned long)NUML_LABEL_COUNT, (unsigned long)NUML_LABEL_COUNT,
                   (double)NUML_OUTPUT_SCALE, (long)NUML_OUTPUT_ZERO_POINT);
        return 3;
    }
    info("Detected KWS input: [1,%lu,%lu,1] INT8 scale=%.9g zero=%ld\n",
         (unsigned long)NUML_FRAME_COUNT,
         (unsigned long)NUML_MEL_BINS,
         (double)inputTensor->params.scale,
         (long)inputTensor->params.zero_point);
    if (!NuML_InitFrontend())
    {
        printf_err("Failed to initialise 512-point RFFT\n");
        return 3;
    }
    if (!NuML_StartDmic())
    {
        return 4;
    }
    pmu_reset_counters();

    info("NuML live Audio KWS ready: PCM16 %lu Hz -> %lux%lu Log-Mel -> %lu labels\n",
         (unsigned long)NUML_SAMPLE_RATE,
         (unsigned long)NUML_FRAME_COUNT,
         (unsigned long)NUML_MEL_BINS,
         (unsigned long)NUML_LABEL_COUNT);
    info("Audio frontend: log_epsilon=%.1e db_floor=%.1f dB\n",
         (double)NUML_LOG_EPSILON, (double)NUML_DB_FLOOR);
    info("KWS trigger: threshold=%.2f margin=%.2f hits=%lu cooldown=%lu hop(s)\n",
         (double)NUML_TRIGGER_THRESHOLD,
         (double)NUML_TRIGGER_MARGIN,
         (unsigned long)NUML_REQUIRED_HITS,
         (unsigned long)NUML_COOLDOWN_HOPS);
    info("Collecting first one-second audio window...\n");

    uint32_t previousSample = 0U;
    uint32_t inferenceHop = 0U;
    while (1)
    {
        uint32_t snapshotSample = 0U;
        if (!NuML_SnapshotLatestClip(previousSample, &snapshotSample))
        {
            /* Drain the log ring fully before sleeping -- see NuML_DrainLogRing() -- then
             * sleep exactly as before; __WFI() itself is unchanged; only what runs ahead of
             * it grew from one blind pump to a bounded drain. */
            NuML_DrainLogRing();
            __WFI();
            continue;
        }
        previousSample = snapshotSample;
        ++inferenceHop;

        const uint64_t frontendStart = pmu_get_systick_Count();
        float rmsDbfs = -120.0f;
        if (!NuML_ExtractLogMel(inputTensor, &rmsDbfs))
        {
            printf_err("Log-Mel frontend failed\n");
            return 5;
        }
        const uint64_t frontendCycles = pmu_get_systick_Count() - frontendStart;

        const uint64_t inferenceStart = pmu_get_systick_Count();
        if (!model.RunInference())
        {
            printf_err("Inference failed\n");
            return 6;
        }
        const uint64_t inferenceCycles = pmu_get_systick_Count() - inferenceStart;

        float scores[NUML_LABEL_COUNT] = {0.0f};
        if (!NuML_ReadScores(outputTensor, scores))
        {
            printf_err("Classification output contract mismatch\n");
            return 7;
        }
        const uint32_t frontendUs = (uint32_t)(frontendCycles * 1000000ULL / SystemCoreClock);
        const uint32_t inferenceUs = (uint32_t)(inferenceCycles * 1000000ULL / SystemCoreClock);
        NuML_ProcessKwsScores(scores, inferenceHop, rmsDbfs, frontendUs, inferenceUs, s_dmaErrorCount);
    }
}
