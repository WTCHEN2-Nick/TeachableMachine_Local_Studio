# Where scripts\download_arm_toolchain.py unpacks the toolchain (hundreds of MB, many files).
runtime/arm-gnu-toolchain/

# Arm GNU Toolchain installers are ~200 MB: over GitHub's 100 MB per-file limit.
# Students install it with scripts\download_arm_toolchain.py (see 使用手冊 6.2).
/2_Compiler and Download Tool Driver/arm-gnu-toolchain-*
